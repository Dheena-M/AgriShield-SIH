# Copy to .env or set these variables before running AgriShield.
OPENWEATHER_API_KEY=your_openweather_api_key
MONGODB_URI=mongodb://agrishield:change_this_password@127.0.0.1:27017/agrishield?authSource=admin
MONGODB_DATABASE=agrishield
# Choose a strong private value; required only to approve/reject doctor verification requests.
ADMIN_VERIFICATION_KEY=replace_with_a_private_admin_key
SARVAM_API_KEY=your_sarvam_api_key_here